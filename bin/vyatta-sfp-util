# Utility for talking to vyatta-sfpd
#

import argparse
import base64
import json
import sys

import zmq

REQ_ENDPOINT = "ipc:///var/run/vyatta/sfp_rep.socket"


def bool_arg(value):
    """
    "true"/"false" (or 1/0, yes/no, on/off) as a bool. argparse's
    type=bool made every non-empty string true, so "false" enabled TX.
    """
    words = {'true': True, '1': True, 'yes': True, 'on': True,
             'false': False, '0': False, 'no': False, 'off': False}
    if value.lower() not in words:
        raise argparse.ArgumentTypeError(f"{value} - should be true or false")
    return words[value.lower()]


def request(req_sock, req_json):
    """Send a request to vyatta-sfpd and return its JSON reply"""
    req_sock.send_json(req_json)
    return req_sock.recv_json()


def print_reply(req_sock, req_json):
    req_sock.send_json(req_json)
    print(req_sock.recv_string())
    return 0


# Each command returns the exit status

def sfp_tx_state_set(req_sock, args):
    return print_reply(req_sock, {'command': 'SFPSTATESET',
                                  'portname': args.port,
                                  'enabled': args.sfp_tx_state_set})


def phy_link_status(req_sock, _args):
    return print_reply(req_sock, {'command': 'PHYLINKSTATUS'})


def phy_speed_duplex_set(req_sock, args):
    return print_reply(req_sock, {
        'command': 'PHYSPEEDDUPLEXSET',
        'portname': args.port,
        'speed': int(args.phy_speed_duplex_set[0]),
        'duplex': args.phy_speed_duplex_set[1],
    })


def phy_autoneg_set(req_sock, args):
    return print_reply(req_sock, {'command': 'PHYAUTONEGSET',
                                  'portname': args.port})


def replay(req_sock, _args):
    return print_reply(req_sock, {'command': 'REPLAY'})


def read_eeprom(req_sock, args):
    req_json = {'command': 'SFPREADEEPROM', 'portname': args.port}
    if args.read_eeprom_offset:
        req_json['offset'] = int(args.read_eeprom_offset[0])
        req_json['length'] = int(args.read_eeprom_offset[1])
    resp = request(req_sock, req_json)
    if resp['result'] != 'OK':
        print(resp['result'])
        return 1
    eeprom_data = base64.b64decode(resp['data'].encode())
    print(''.join(f'{b:02x}' for b in eeprom_data))
    return 0


def query_eeprom(req_sock, args):
    resp = request(req_sock, {'command': 'SFPQUERYEEPROM',
                              'portname': args.port})
    if resp['result'] != 'OK':
        print(resp['result'])
        return 1
    pages = ', '.join(f'{int(b):02x}' for b in resp['pages'])
    print('Type: ' + resp['porttype'] + ', pages: ' + pages)
    return 0


def sfp_insert_remove(req_sock, args):
    portid, porttype, presence, extra_state = args.sfp_insert_remove
    if presence not in ('true', 'false'):
        print(f'{presence} - should be either true or false')
        return 1
    resp = request(req_sock, {
        'command': 'SFPINSERTEDREMOVED',
        'portname': args.port,
        'portid': portid,
        'porttype': porttype,
        'inserted': presence == 'true',
        'extra_state': json.loads(extra_state),
    })
    if resp['result'] != 'OK':
        print(resp['result'])
        return 1
    return 0


# (option, whether it acts on --port, command), in the order main checked
# them; the options are mutually exclusive
COMMANDS = [
    ('sfp_tx_state_set', True, sfp_tx_state_set),
    ('phy_link_status', False, phy_link_status),
    ('phy_speed_duplex_set', True, phy_speed_duplex_set),
    ('phy_autoneg_set', True, phy_autoneg_set),
    ('replay', False, replay),
    ('read_eeprom', True, read_eeprom),
    ('read_eeprom_offset', True, read_eeprom),
    ('query_eeprom', True, query_eeprom),
    ('sfp_insert_remove', True, sfp_insert_remove),
]


def main(cmd_parser, cmd_args):
    context = zmq.Context()
    req_sock = context.socket(zmq.REQ)
    req_sock.connect(REQ_ENDPOINT)

    for option, needs_port, command in COMMANDS:
        value = getattr(cmd_args, option)
        if option == 'sfp_tx_state_set':
            given = value is not None
        else:
            given = bool(value)
        if not given:
            continue
        # sfp-insert-remove checks its presence word before the port
        if option == 'sfp_insert_remove' and \
                value[2] not in ('true', 'false'):
            sys.exit(command(req_sock, cmd_args))
        if needs_port and not cmd_args.port:
            print("Missing port argument")
            sys.exit(1)
        sys.exit(command(req_sock, cmd_args))

    cmd_parser.print_help()
    sys.exit(1)


def make_parser():
    parser = argparse.ArgumentParser()
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--sfp-tx-state-set", metavar='ENABLED',
                       action='store', type=bool_arg,
                       help="Set the TX state of the SFP (true or false)")
    group.add_argument("--phy-link-status", action='store_true',
                       help="Get the link status of any embedded PHY on "
                       "the SFP")
    group.add_argument("--phy-speed-duplex-set", nargs=2,
                       help="Force speed and duplex of embedded PHY on the "
                       "SFP")
    group.add_argument("--phy-autoneg-set", action='store_true',
                       help="Set autoneg of embedded PHY on the SFP")
    group.add_argument("--replay", action='store_true',
                       help="Perform a replay of state for publishing")
    group.add_argument("--read-eeprom", action='store_true',
                       help="Read entire EEPROM")
    group.add_argument("--read-eeprom-offset", nargs=2,
                       help="Read EEPROM from given offset upto given length")
    group.add_argument("--query-eeprom", action='store_true',
                       help="Query EEPROM supported pages and type")
    group.add_argument("--sfp-insert-remove", nargs=4,
                       help="Trigger presence change for port - <PORTNUM> "
                       "<PORTTYPE> <PRESENCE> <EXTRA_STATE>")
    parser.add_argument("--port", action='store',
                        help="Port to act upon")
    return parser


if __name__ == '__main__':
    PARSER = make_parser()
    main(PARSER, PARSER.parse_args())
